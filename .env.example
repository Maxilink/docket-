# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Server only. Never share or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string. The reminder schedule sends it to prove the call is genuine.
CRON_SECRET=make-up-a-long-random-string

# Termii: dashboard > API settings. Secret. Server only.
TERMII_API_KEY=your-termii-api-key
TERMII_BASE_URL=https://v4.api.termii.com
# Your approved Sender ID (3-11 characters), or WhatsApp device name if TERMII_CHANNEL=whatsapp
TERMII_SENDER_ID=CDiary
# dnd (recommended once Termii activates it), generic, or whatsapp
TERMII_CHANNEL=dnd

NEXT_PUBLIC_APP_NAME=C-Diary
